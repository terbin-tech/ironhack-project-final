FROM node:26.13.1-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS build
WORKDIR /app
COPY expensy_backend/package.json expensy_backend/package-lock.json ./
RUN npm ci
COPY expensy_backend/tsconfig.json ./
COPY expensy_backend/src ./src
RUN npm run build && \
    npm prune --omit=dev

FROM node:26.13.1-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc

# Security updates, and tini so node does not run as PID 1
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends tini && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /etc/ssl/certs

WORKDIR /app
ENV NODE_ENV=production \
    PORT=8706

COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Folder made above: one created by COPY --chmod gets mode 644, which the
# non-root user cannot enter.
COPY --chmod=644 certs/rds-global-bundle.pem /etc/ssl/certs/rds-global-bundle.pem

EXPOSE 8706

# Numeric (node), so Kubernetes can verify runAsNonRoot
USER 1000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/server.js"]
